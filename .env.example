# Keycloak SaaS Development Environment Variables
# Copy this to .env.local for local development (git-ignored)

# --- Keycloak Configuration ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-change-me-in-dev
KEYCLOAK_REALM=master
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KC_PROXY=edge

# --- Database (PostgreSQL 15+, single choice across all environments) ---
DB_VENDOR=postgres
DB_ADDR=postgres
DB_PORT=5432
DB_DATABASE=keycloak
DB_USER=keycloak
DB_PASSWORD=keycloak-password-dev
DB_SCHEMA=public
# Local: postgres service in docker-compose
# Staging/Prod: RDS endpoint in terraform output

# --- Multi-Tenancy ---
KEYCLOAK_TENANT_STRATEGY=realm-per-tenant
KEYCLOAK_REALM_AUTO_CREATE=true
TENANT_DOMAIN_PREFIX=realm-

# --- Security Parameters ---
KC_SPI_REALM_REP_PROVIDER=jpa
KC_SPI_EVENT_LISTENER_EVENT_STORE_PROVIDER=jpa
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_MINUTES=1440
SSO_SESSION_IDLE_MINUTES=30
SSO_SESSION_MAX_MINUTES=1440
PASSWORD_POLICY=length(12) and specialChars(1) and upperAndLowerCase

# --- Frontend ---
REACT_APP_API_BASE_URL=http://localhost:3000
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=master
REACT_APP_KEYCLOAK_CLIENT_ID=frontend-client

# --- Backend API ---
API_PORT=3000
API_NODE_ENV=development
API_LOG_LEVEL=debug
API_KEYCLOAK_ADMIN_REALM=master
API_KEYCLOAK_ADMIN_USERNAME=admin
API_KEYCLOAK_ADMIN_PASSWORD=admin-change-me-in-dev
API_KEYCLOAK_ADMIN_CLIENT_ID=admin-client
API_KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# --- AWS (for staging/production) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RDS_ENDPOINT=
RDS_PORT=5432

# --- Billing / Metering ---
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Feature Flags ---
FEATURE_MFA_ENABLED=true
FEATURE_SOCIAL_LOGIN_ENABLED=true
FEATURE_SAML_ENABLED=false
FEATURE_LDAP_ENABLED=true

# --- Observability ---
LOG_LEVEL=debug
DATADOG_API_KEY=
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# --- Development Only ---
DEBUG=false
MOCK_EXTERNAL_SERVICES=false
